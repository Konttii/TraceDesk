# Пример конфигурации переменных окружения (скопируйте в .env при необходимости)
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tracedesk
DB_USER=tracedesk
DB_PASSWORD=tracedesk

# MinIO (S3-хранилище вложений)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tracedesk-attachments

# Redis (OTP-коды, черновики регистрации, кулдауны)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (асинхронная очередь писем)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# SMTP / Почта (по умолчанию — локальный Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@tracedesk.kz
MAIL_SENDER_NAME=TraceDesk Security

# Пример для Gmail SMTP (используйте App Password, а не основной пароль):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=your-email@gmail.com

# Пароль демо-аккаунтов (irina, pavel, oleg, anna)
DEMO_PASSWORD=password
