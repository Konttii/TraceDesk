# Пример конфигурации переменных окружения (скопируйте в .env при необходимости)
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tracedesk
DB_USER=tracedesk
DB_PASSWORD=tracedesk

# MinIO (S3-хранилище вложений)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tracedesk-attachments

# Пароль демо-аккаунтов (irina, pavel, oleg, anna)
DEMO_PASSWORD=password
